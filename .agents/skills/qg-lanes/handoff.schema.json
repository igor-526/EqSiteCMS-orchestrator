{
  "type": "object",
  "properties": {
    "lane": {
      "type": "string",
      "enum": [
        "QG-ENV",
        "QG-BE",
        "QG-FE-AUTO",
        "QG-FE-MANUAL",
        "QG-LIVE",
        "QG-CONTRACTS",
        "QG-FORMAT"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked-env", "not_applicable"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "enum": ["blocking", "minor", "pre-existing", "blocked-env"]
          },
          "key_check": {
            "type": "boolean"
          },
          "owner_profile": {
            "type": "string",
            "enum": ["Planner", "Backend", "Frontend", "Site Consumer", "Quality Gate"]
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "suggested_unit": {
            "type": "string"
          }
        },
        "required": ["class", "owner_profile", "summary"],
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "required": ["cmd", "result"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["lane", "status", "findings"],
  "additionalProperties": false
}
