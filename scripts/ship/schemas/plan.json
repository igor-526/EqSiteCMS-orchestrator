{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical shipping plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "change",
    "kind",
    "branchName",
    "skippedBranches",
    "commitMessage",
    "inventory",
    "exclusions",
    "repos",
    "blockers",
    "hasBlockers",
    "noop",
    "PLAN_TOKEN"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "change": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "feature",
        "bug"
      ]
    },
    "branchName": {
      "type": "string"
    },
    "skippedBranches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "trailers"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "maxLength": 72
        },
        "trailers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "origin"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "path",
          "branch",
          "head",
          "origin",
          "remoteHeads",
          "blockers",
          "included",
          "foreign",
          "excluded",
          "warnings",
          "hasRelease",
          "ownerRepo",
          "runtimeAliases",
          "fingerprint",
          "pushOrigins"
        ],
        "properties": {
          "status": {
            "enum": [
              "changed",
              "untouched"
            ]
          },
          "path": {
            "type": "string"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "head": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "remoteHeads": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "included": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "status",
                "blobHash",
                "mode",
                "indexHash",
                "statusHash"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                "blobHash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40,64}$"
                },
                "mode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "indexHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "statusHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "foreign": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "status",
                "blobHash",
                "mode",
                "indexHash",
                "statusHash"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                "blobHash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40,64}$"
                },
                "mode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "indexHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "statusHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "rule"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasRelease": {
            "type": "boolean"
          },
          "ownerRepo": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "repo"
                ],
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "runtimeAliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "statusHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "indexHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pushOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hasBlockers": {
      "type": "boolean"
    },
    "noop": {
      "type": "boolean"
    },
    "PLAN_TOKEN": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
