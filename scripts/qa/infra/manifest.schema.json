{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eqsite-qa-infra-manifest-v1",
  "description": "Structural schema; contracts.validate additionally enforces expiry, exact binding, resource/run prefix, command allowlist and credential endpoint binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "change",
    "runId",
    "kind",
    "target",
    "resource",
    "service",
    "nodeIds",
    "timeout",
    "cleanupTimeout",
    "cleanup"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "change": {
      "enum": [
        "harden-agent-verification-pipeline",
        "seo-metrica-task-monitor"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "enum": [
        "pg",
        "nats"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "host",
            "port",
            "isolation",
            "database",
            "role"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "isolation": {
              "const": "dedicated-test-db-role"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_test$"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_test$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "host",
            "port",
            "isolation"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "isolation": {
              "const": "dedicated-test-broker"
            }
          }
        }
      ]
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "pattern": "^qa_[0-9a-f]{32}_[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream",
            "durable",
            "subject"
          ],
          "properties": {
            "stream": {
              "type": "string"
            },
            "durable": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            }
          }
        }
      ]
    },
    "service": {
      "enum": [
        "seo-service",
        "ya-metrica-service"
      ]
    },
    "nodeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "cleanupTimeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "cleanup": {
      "const": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "change": {
          "const": "harden-agent-verification-pipeline"
        },
        "service": {
          "const": "seo-service"
        },
        "kind": {
          "const": "pg"
        },
        "nodeIds": {
          "anyOf": [
            {
              "const": [
                "selftest"
              ]
            },
            {
              "items": {
                "anyOf": [
                  {
                    "pattern": "^tests/integration/test_acceptance_boundaries\\.py::test_[a-z0-9_]+(\\[[a-zA-Z0-9_-]+\\])?$"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "change": {
          "const": "harden-agent-verification-pipeline"
        },
        "service": {
          "const": "seo-service"
        },
        "kind": {
          "const": "nats"
        },
        "nodeIds": {
          "anyOf": [
            {
              "const": [
                "selftest"
              ]
            },
            {
              "items": {
                "anyOf": [
                  {
                    "pattern": "^tests/integration/test_nats_broker\\.py::test_[a-z0-9_]+(\\[[a-zA-Z0-9_-]+\\])?$"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "change": {
          "const": "harden-agent-verification-pipeline"
        },
        "service": {
          "const": "ya-metrica-service"
        },
        "kind": {
          "const": "pg"
        },
        "nodeIds": {
          "anyOf": [
            {
              "const": [
                "selftest"
              ]
            },
            {
              "items": {
                "anyOf": [
                  {
                    "pattern": "^tests/integration/test_acceptance_helpers\\.py::test_[a-z0-9_]+(\\[[a-zA-Z0-9_-]+\\])?$"
                  },
                  {
                    "pattern": "^tests/integration/test_cleanup_worker_postgres\\.py::test_[a-z0-9_]+(\\[[a-zA-Z0-9_-]+\\])?$"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "change": {
          "const": "harden-agent-verification-pipeline"
        },
        "service": {
          "const": "ya-metrica-service"
        },
        "kind": {
          "const": "nats"
        },
        "nodeIds": {
          "anyOf": [
            {
              "const": [
                "selftest"
              ]
            },
            {
              "items": {
                "anyOf": [
                  {
                    "pattern": "^tests/integration/test_nats_broker\\.py::test_[a-z0-9_]+(\\[[a-zA-Z0-9_-]+\\])?$"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "change": {
          "const": "seo-metrica-task-monitor"
        },
        "service": {
          "const": "ya-metrica-service"
        },
        "kind": {
          "const": "pg"
        },
        "nodeIds": {
          "items": {
            "enum": [
              "tests/integration/test_metrica_task_list_postgres.py::test_aggregate_identity",
              "tests/integration/test_metrica_task_list_postgres.py::test_consistent_read_snapshot",
              "tests/integration/test_metrica_task_list_postgres.py::test_history_survives_cleanup",
              "tests/integration/test_metrica_task_list_postgres.py::test_status_order_pagination"
            ]
          }
        }
      }
    }
  ]
}
