#!/usr/bin/env node

/**
 * stackctl — machine-readable Docker stack control for EqSiteCMS.
 *
 * stdout is reserved for JSON results. Progress and human-readable tables go
 * to stderr so agents can parse stdout without stripping log lines.
 */

import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';

const PROJECT_ROOT = '/home/igor/projects/eqSiteCMS';
const COMPOSE_DIR = join(PROJECT_ROOT, '.docker-compose');
const LOCK_FILE = '/tmp/stackctl.lock';
const SCRIPT_PATH = fileURLToPath(import.meta.url);

// These definitions intentionally mirror the Makefile commands.
